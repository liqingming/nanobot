<idea-plugin>
    <id>dev.nanobot.rider.context</id>
    <name>Nanobot Context</name>
    <version>0.1.1</version>
    <vendor>nanobot fork</vendor>
    <description><![CDATA[
        将主动选中的文件路径、行号和代码快照加入本机 nanobot CLI 待发送上下文。
        不自动采集项目；不直接调用模型。终端需先执行 /ide on。
    ]]></description>
    <idea-version since-build="242"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Nanobot Context" displayType="BALLOON"/>
    </extensions>
    <actions>
        <action id="Nanobot.AddSelection"
                class="dev.nanobot.rider.AddSelectionAction"
                text="添加到 nanobot 上下文"
                description="将选中代码快照添加到指定终端会话，等待问题一起发送">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt N"/>
        </action>
    </actions>
</idea-plugin>
